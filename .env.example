# IoT File Server - Configuration
# Copy to .env and adjust: cp .env.example .env

# API key for authentication (X-API-Key header)
API_KEY=changeme

# Server
HOST=0.0.0.0
PORT=8000

# The address a DEVICE should dial to reach this installation.
#
# NOT the same thing as HOST or STREAM_HOST above: those are BIND addresses and
# say which interfaces to listen on. Behind NAT, a proxy or a dynamic DNS name
# they have nothing to do with what a station in the field should be pointed at,
# and nothing here can derive one from the other.
#
# Only the config generator reads it, to prefill the server address in a
# generated device configuration. Leave it empty and that field is left blank
# with a note, which is deliberate - a guessed address looks answered.
# PUBLIC_HOST=stations.example.org

# Directories (relative or absolute)
# UPLOAD_DIR=./data/incoming
# DOWNLOAD_DIR=./data/outgoing

# SSL (optional, for HTTPS)
# SSL_CERTFILE=./cert.pem
# SSL_KEYFILE=./key.pem

# Limits
# MAX_FILE_SIZE=52428800  # 50 MB per single request / chunk

# Chunked upload: a device whose file is too large for its modem buffer splits
# it into pieces that the server reassembles by byte offset. The *reassembled*
# file may be larger than a single chunk, so it has its own ceiling.
# MAX_ASSEMBLED_SIZE=524288000  # 500 MB

# Abandoned <name>.partial files (a device that never sent its final chunk) are
# swept at startup once older than this (hours).
# PARTIAL_MAX_AGE_H=48

# Per-chunk read timeout while receiving an upload (seconds).
# Frees the connection if a device freezes mid-transfer (responds HTTP 408).
# UPLOAD_CHUNK_TIMEOUT=30

# Concurrency (recommended: 2 for Raspberry Pi, 4 for more powerful servers)
# WORKERS=1

# Logging
# server.log        -> operational events + 4xx/5xx on real endpoints
# server.access.log -> one line per HTTP request
# LOG_FILE=./server.log
# ACCESS_LOG_FILE=./server.access.log
# LOG_MAX_BYTES=10485760   # 10 MB per file before rotation
# LOG_BACKUP_COUNT=5       # number of rotated files to keep


# ==========================================================================
# Streaming server (streaming_server.py - separate process / service)
#
# Receives a live TCP byte stream from devices instead of finished file
# uploads: raw UBX + RTCM3 interleaved with private framed messages
# (sensors / identification / heartbeat / CLI), one persistent socket per
# station. Independent of the batch file server above.
# ==========================================================================

# TCP data plane (must match the device's configured port)
# STREAM_HOST=0.0.0.0
# STREAM_PORT=9000

# HTTP admin / CLI API (same X-API-Key as above)
#   GET  /health
#   GET  /stream/stations
#   POST /stream/{station_id}/cli   {"cmd": "sysinfo"}
# Do NOT expose this port publicly: it can reboot the device and push firmware.
# It binds separately from the data plane above and to loopback by default —
# STREAM_HOST has to be reachable for the device, this must not be. Only widen it
# if something off-host needs the admin API, and then put it behind a firewall.
# STREAM_ADMIN_HOST=127.0.0.1
# STREAM_ADMIN_PORT=9001

# Output: <STREAM_DIR>/<stationId>/{ubx,rtcm3,sensors,raw,cli}/
# STREAM_DIR=./data/incoming_stream

# Pre-shared token for the remote CLI. MUST match the token configured on the
# device. Empty = no authentication (the device-side allowlist still applies).
# STREAM_CLI_SECRET=

# Byte-exact capture of every connection (for replay.py and reprocessing).
# Largest data item -> pruned after STREAM_RAW_MAX_AGE_H hours at startup.
# STREAM_RAW_CAPTURE=true
# STREAM_RAW_MAX_AGE_H=168   # 7 days

# No bytes at all for this long -> close the socket. Must exceed the device's
# heartbeat interval.
# STREAM_IDLE_TIMEOUT=180

# CLI timeouts. A download command makes the device close the socket, transfer,
# and only reconnect afterwards to answer -> its own generous timeout.
# STREAM_CLI_TIMEOUT=60
# STREAM_CLI_TRANSFER_TIMEOUT=600

# A connection must identify itself within this many bytes.
# STREAM_PRE_IDENT_CAP=8192

# STREAM_LOG_FILE=./streaming.log

# ---- RTK rover correction downlink (streaming/rover.py) --------------------
# In-fleet routing: which base station feeds which rovers, entirely inside this
# server (no external caster). Format "base:rover[+rover...][,base:rover...]".
# Each base gets its own router, fed in-process by a RoverSourceSink (or
# BaseArpSink, if auto-discovery below is on) on the base's stream. A pair
# here is a MANUAL PIN: rover_discovery.py's auto-subscription never touches
# a station id listed here (or in STREAM_ROVER_STATIONS below) - a hand-
# configured pair always wins. Hot-reloadable without a restart: POST
# /stream/rover/reload or SIGHUP re-reads this key and applies the diff live.
# Empty (the default) = no manually-pinned in-fleet routing.
# STREAM_ROVER_BASES=1001:1002

# ---- Automatic rover -> nearest-base subscription (streaming/rover_discovery.py) --
# A station that declares role=rover in its IDENT (device fw with the role
# byte - see streaming/rover_discovery.py's module docstring) is subscribed to
# its nearest base automatically, live, no restart, no config edit. Needs no
# station ids of its own for rovers; only bases need trust:
STREAM_ROVER_AUTO_ENABLE=true

# Station ids trusted as a correction SOURCE when they identify as role=base -
# a bare role=base claim on the wire is not enough by itself (see
# rover_discovery.py's module docstring for why). A base already listed as a
# STREAM_ROVER_BASES key above needs no entry here. Empty (the default) means
# only statically-configured bases can ever be auto-subscribed to.
# STREAM_ROVER_AUTO_BASE_STATIONS=1001

# Beyond this baseline, a correction cannot help - the rover is left
# unsubscribed rather than fed a useless stream.
# STREAM_ROVER_MAX_BASELINE_KM=40

# A rover only switches from its current base to a nearer one if the nearer
# one wins by more than this - hysteresis against flapping near the midpoint
# between two bases.
# STREAM_ROVER_SWITCH_MARGIN_KM=5

# Which station ids receive RTCM3 corrections from an EXTERNAL NTRIP source (the
# block at the bottom). Independent of STREAM_ROVER_BASES; use this when there is
# no base in the fleet. Empty (the default) turns the external downlink off: no
# caster connection, no tasks, nothing to go wrong on a server that runs no rovers.
# STREAM_ROVER_STATIONS=1001

# Per-rover queue depth in whole RTCM3 frames. One epoch from a typical base is
# about six frames. Deliberately shallow - corrections are epoch-bound, so a
# deeper queue delivers staler data, not more useful data.
# STREAM_ROVER_QUEUE=24

# Allowlist of RTCM3 message types forwarded to rovers; empty (the default)
# forwards everything. Only worth setting on a link that cannot carry the full
# stream: the device drains its modem buffer at a fixed rate, so a type the
# receiver cannot use costs one it could have used. 1005 + one MSM per
# constellation is a complete RTK set - drop the constellations the receiver does
# not track (a ZED-F9P reports NavIC/1137 as "not used" and never needs it).
# STREAM_ROVER_RTCM_TYPES=1005,1077,1087,1097

# The correction source. Until a base station exists in your own fleet, this is
# a public NTRIP caster. RTK2GO needs no registration for clients: the username
# is any valid email address and the password is not checked.
# Leave STREAM_NTRIP_MOUNT empty to configure rovers without a source yet - the
# server will say so on startup rather than sitting there silently.
# STREAM_NTRIP_HOST=rtk2go.com
# STREAM_NTRIP_PORT=2101
# STREAM_NTRIP_MOUNT=FP07
# STREAM_NTRIP_USER=you@example.com
# STREAM_NTRIP_PASS=none

# ---- NTRIP caster push (streaming/ntrip.py, caster/) ------------------------
# The other direction from the block above: forward a station's demuxed RTCM3
# live to an NTRIP caster mountpoint (one mountpoint per station, mountpoint
# name == station id), so hardware that cannot use the direct TCP stream can
# instead pull its corrections as a standard NTRIP client. Defaults point at
# the caster bundled in caster/ (build + provision it first - see
# caster/README.md); any caster speaking the NTRIP 1.0 SOURCE handshake works
# here, so pointing this at an external caster instead only needs a different
# host/port.
#
# A station missing from STREAM_CASTER_PASSWORDS gets no caster push - its
# mountpoint may not be provisioned. Empty (the default) turns this off
# entirely: no caster connection, no task, nothing to go wrong on a server
# that runs no caster.
# STREAM_CASTER_ENABLE=true
# STREAM_CASTER_HOST=127.0.0.1
# STREAM_CASTER_PORT=2101
# STREAM_CASTER_PASSWORDS=1001:changeme
#
# STREAM_CASTER_STATIONS is the list of stations that have a mountpoint. Run
# caster/setup.sh after setting it: it builds the caster, writes its
# sourcetable/source.auth, and fills in STREAM_CASTER_PASSWORDS above with one
# freshly generated password per station, so the caster and this server always
# agree on the credential. The server reads it too, because the auto-provisioner
# below has to render the complete sourcetable, not just one station.
# STREAM_CASTER_STATIONS=1001
#
# Automatic mountpoints: a station that identifies with role=base (its IDENT
# frame) is provisioned on the BUNDLED caster the moment it connects - password
# generated, sourcetable/source.auth rewritten, caster SIGHUPed, push started on
# the live session, and the three keys above written back here. Reconfiguring a
# device to be a base is then the whole procedure: no edit here, no restart, no
# second caster/setup.sh run. Its position (Millipede's NEAR routing) fills in
# from its own first RTCM 1005 instead of from the archive.
#
# The role byte alone is the gate, unlike STREAM_ROVER_AUTO_BASE_STATIONS above,
# which guards the same claim much harder - a mountpoint only publishes that
# station under its own name, while a trusted correction source gets pushed into
# our own rovers. Off by default:
# it writes files and publishes a station, which is a deliberate decision.
# Never touches STREAM_CASTER_TARGETS below - those casters' config is not ours.
# STREAM_CASTER_AUTO_ENABLE=true
#
# Where the bundled caster's config lives. Only the auto-provisioner writes
# here; set it when the caster was installed outside this repo, or to point a
# second instance on this host at its own caster.
# STREAM_CASTER_ETC_DIR=./caster/millipede-caster/etc

# ---- Additional caster targets ---------------------------------------------
# The keys above configure ONE caster (the bundled one). To push the same
# stations to further casters as well - a public one, a partner's, a second
# instance you evaluate against - name them here and give each a set of
# STREAM_CASTER_<NAME>_* keys. All of it is additive: a station goes to the
# bundled caster and to every target that has a mountpoint for it.
#
# The name is free-form and only builds the key prefix (upper-cased, "-" -> "_").
# Listing a name is what enables it; remove it from the list to switch it off,
# or set STREAM_CASTER_<NAME>_ENABLE=false to keep its settings around while
# it is off. HOST defaults to 127.0.0.1 and PORT to 2101 per target.
#
# Per target, a station missing from that target's _PASSWORDS is not forwarded
# there - mountpoints are provisioned per caster. Some casters authenticate
# NTRIP 1.0 source pushes with a single global password rather than one per
# mountpoint; then every station in that target's list repeats the same value.
# STREAM_CASTER_TARGETS=partner,bkg
# STREAM_CASTER_PARTNER_HOST=ntrip.example.org
# STREAM_CASTER_PARTNER_PORT=2101
# STREAM_CASTER_PARTNER_PASSWORDS=1001:changeme
# STREAM_CASTER_BKG_PORT=2104
# STREAM_CASTER_BKG_PASSWORDS=1001:sharedpw,1002:sharedpw
